PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@m0.wv1nflg.mongodb.net/vaultshare?retryWrites=true&w=majority&appName=M0

# â”€â”€ JWT secrets â€” use long random strings in production â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here
TEMP_SECRET=your_temp_secret_here

# â”€â”€ Frontend URL(s) for CORS â€” comma-separated if multiple â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# â”€â”€ Gmail SMTP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Use an App Password (not your real Gmail password)
# See: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# â”€â”€ AWS S3 (file + version storage) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Use a PRIVATE bucket, separate from any public/static-website-hosting bucket.
# Credentials are read via the default AWS SDK credential chain: set
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY below, or omit both and attach an
# IAM role to the EC2 instance instead (recommended in production).
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-vaultshare-files-bucket
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Max upload size in MB (default: 50)
MAX_FILE_SIZE_MB=50

AUDIT_VIEW_DEDUP_WINDOW_MS=5000

# ── Virus scanning (optional) ────────────────────────────────────────────────
# Set to true to enable ClamAV scanning on every upload (requires clamscan CLI)
ENABLE_VIRUS_SCAN=false
# Set to true to REJECT uploads when ClamAV is unavailable (fail closed)
VIRUS_SCAN_STRICT=false

